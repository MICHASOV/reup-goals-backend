# Runtime
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_READ_TIMEOUT=90s
HTTP_WRITE_TIMEOUT=6m
HTTP_IDLE_TIMEOUT=90s
BROWSER_AUTH_ONLY=false
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:3000
APP_VERSION=REUP.goals v2
SUPPORT_EMAIL=support@example.com
DOCUMENTATION_URL=
CHANGELOG_URL=

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=reup_goals
DB_PASSWORD=replace-me
DB_NAME=reup_goals
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# Privacy and data residency
# development/test are never valid production compliance modes.
PRIVACY_MODE=development
DATA_RESIDENCY_REGION=local-dev
PRIVACY_CONTACT_EMAIL=privacy@example.com
CROSS_BORDER_TRANSFER_REGISTERED=false
GDPR_TRANSFER_MECHANISM=

# Operational retention. Business content is retained until account/workspace deletion.
RETENTION_INTERVAL=24h
AUTH_CODE_RETENTION_DAYS=30
HTTP_REQUEST_LOG_RETENTION_DAYS=90
PRODUCT_EVENT_RETENTION_DAYS=365
AI_CALL_LOG_RETENTION_DAYS=180
BACKGROUND_JOB_RETENTION_DAYS=30
LEGAL_EVIDENCE_RETENTION_DAYS=1095
PRIVACY_REQUEST_RETENTION_DAYS=1095

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_AUDITOR_MODEL=gpt-5.4
OPENAI_ADVISOR_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_AUDITOR_MAX_OUTPUT_TOKENS=1800
OPENAI_AUDITOR_COMPACT_THRESHOLD=120000
OPENAI_ADVISOR_COMPACT_THRESHOLD=60000
OPENAI_PROXY_URL=direct
ENABLE_AI_BENCHMARK=false

# AI governance
AI_ADMIN_KEY=
AI_RATE_LIMIT_PER_MINUTE=60
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
AI_JOB_WORKERS=2

# Email
UNISENDER_API_KEY=
UNISENDER_BASE_URL=https://api.unisender.com/ru/api
UNISENDER_SENDER_EMAIL=noreply@example.com
UNISENDER_SENDER_NAME=REUP.goals
UNISENDER_LIST_ID=
UNISENDER_SERVICE_LIST_TITLE=REUP.goals service emails

# Billing
BILLING_PAYMENTS_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
BILLING_ADMIN_KEY=
INVOICE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_PLAN_NAME=REUP.goals Founder
CLOUDPAYMENTS_AMOUNT=3490
CLOUDPAYMENTS_FIRST_PAYMENT_AMOUNT=3490
CLOUDPAYMENTS_CURRENCY=RUB
CLOUDPAYMENTS_TRIAL_DAYS=0
# Optional hosted checkout URL for the TopPayments redirect integration.
# When omitted, the existing CloudPayments widget remains the compatibility provider.
TOPPAYMENTS_CHECKOUT_URL=
