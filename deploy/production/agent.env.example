# Install as /etc/reup-goals-production/agent.env on the German host.
PORT=8092
LISTEN_HOST=127.0.0.1
GO_INTERNAL_URL=http://127.0.0.1:8082
AGENT_RUNTIME_SECRET=replace-with-the-same-secret-as-the-production-api

OPENAI_API_KEY=replace-with-the-production-openai-key

AGENT_COMPACT_THRESHOLD=100000
AGENT_REASONING_EFFORT=max
AGENT_PROVIDER_TIMEOUT=45m
