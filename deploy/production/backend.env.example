# Install as /etc/reup-goals-production/backend.env on the German host.
APP_ENV=production
HTTP_PORT=8082
PRIVACY_MODE=gdpr
DATA_RESIDENCY_REGION=eu-de
PRIVACY_CONTACT_EMAIL=privacy@example.com
CROSS_BORDER_TRANSFER_REGISTERED=true
GDPR_TRANSFER_MECHANISM=standard-contractual-clauses

DB_HOST=managed-postgres.example
DB_PORT=5432
DB_USER=reup_goals
DB_PASSWORD=
DB_NAME=reup_goals
DB_SSLMODE=verify-full
DB_APPLICATION_NAME=reup-goals-production
DB_MAX_OPEN_CONNS=6
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=1m
JOB_QUEUE_NAMESPACE=production

JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://reupgoals.pro,https://www.reupgoals.pro
HTTP_READ_TIMEOUT=10m
HTTP_WRITE_TIMEOUT=0s
HTTP_IDLE_TIMEOUT=90s
BROWSER_AUTH_ONLY=true
COOKIE_SECURE=true
FRONTEND_BASE_URL=https://reupgoals.pro
APP_VERSION=REUP.goals v2
SUPPORT_EMAIL=reupgoals@gmail.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_AUDITOR_MODEL=gpt-5.6-luna
OPENAI_ADVISOR_MODEL=gpt-5.6-luna
OPENAI_TASK_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
AGENT_RUNTIME_ENABLED=true
AGENT_RUNTIME_URL=http://127.0.0.1:8092
AGENT_RUNTIME_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
AGENT_RUNTIME_MAX_TURNS=120
AGENT_RUNTIME_TIMEOUT=45m
AGENT_RELEASE_ID=
AGENT_COMPACT_THRESHOLD=100000
AI_RATE_LIMIT_PER_MINUTE=60
AI_DAILY_BUDGET_USD=0
AI_MONTHLY_BUDGET_USD=0
AI_JOB_WORKERS=4
AI_AGENT_JOB_WORKERS=4

RETENTION_INTERVAL=24h
AUTH_CODE_RETENTION_DAYS=30
HTTP_REQUEST_LOG_RETENTION_DAYS=90
PRODUCT_EVENT_RETENTION_DAYS=365
AI_CALL_LOG_RETENTION_DAYS=180
BACKGROUND_JOB_RETENTION_DAYS=30
LEGAL_EVIDENCE_RETENTION_DAYS=1095
PRIVACY_REQUEST_RETENTION_DAYS=1095

UNISENDER_API_KEY=
UNISENDER_BASE_URL=https://api.unisender.com/ru/api
UNISENDER_SENDER_EMAIL=noreply@reupgoals.pro
UNISENDER_SENDER_NAME=REUP.goals
UNISENDER_LIST_ID=
UNISENDER_SERVICE_LIST_TITLE=REUP.goals service emails

BILLING_PAYMENTS_ENABLED=true
BILLING_ENFORCEMENT_ENABLED=true
BILLING_ADMIN_KEY=
INVOICE_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_BASE_URL=https://api.cloudpayments.ru
CLOUDPAYMENTS_CURRENCY=RUB
TOPPAYMENTS_CHECKOUT_URL=
