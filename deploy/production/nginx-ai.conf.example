limit_req_zone $binary_remote_addr zone=reup_ai:10m rate=30r/s;

server {
    listen 80;
    listen [::]:80;
    server_name ai.reupgoals.pro;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ai.reupgoals.pro;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/ai.reupgoals.pro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai.reupgoals.pro/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:REUPAI:10m;
    ssl_session_tickets off;

    client_max_body_size 128m;
    client_body_timeout 3600s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    location = /healthz {
        proxy_pass http://127.0.0.1:8092;
        proxy_set_header Host $host;
        proxy_hide_header Server;
    }

    # Replace the placeholder with the fixed public egress IP of the Russian API.
    location ~ ^/(v1/runs/|openai/) {
        allow RUSSIAN_API_PUBLIC_IP;
        deny all;
        limit_req zone=reup_ai burst=120 nodelay;
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_hide_header Server;
    }

    location / {
        return 404;
    }
}
