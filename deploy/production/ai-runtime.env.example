# Install as /etc/reup-goals/ai-production.env on the German host.
# Keep it readable only by root (chmod 600). Never copy these secrets to git.
PORT=8092
LISTEN_HOST=127.0.0.1
# The reverse tunnel is initiated by the Russian API host. Keeping this URL
# on loopback removes the public internet from runtime tool callbacks.
GO_INTERNAL_URL=http://127.0.0.1:18080

# This secret authenticates Russian API calls to the Agents SDK runtime.
AGENT_RUNTIME_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# This different secret authenticates the Russian OpenAI-compatible client.
AI_GATEWAY_SECRET=replace-with-a-second-unique-random-secret-of-at-least-32-characters
AI_GATEWAY_MAX_REQUEST_BYTES=134217728

# The real OpenAI credential exists only on this German host.
OPENAI_API_KEY=replace-with-the-production-openai-key
OPENAI_UPSTREAM_URL=https://api.openai.com
OPENAI_PROXY_URL=direct

AGENT_COMPACT_THRESHOLD=100000
AGENT_REASONING_EFFORT=max
AGENT_PROVIDER_TIMEOUT=45m
OPENAI_GATEWAY_TIMEOUT=45m
